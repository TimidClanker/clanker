{
  "name": "clanker",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "auth": "bun run src/auth/cli.ts",
    "login": "bun run src/auth/cli.ts login",
    "beeper": "bun run src/extensions/chat/adapters/beeper/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@beeper/desktop-api": "6.0.0",
    "@chat-adapter/discord": "4.41.1",
    "@chat-adapter/state-memory": "4.41.1",
    "@earendil-works/chord": "1.0.1",
    "@earendil-works/pi-ai": "1.0.1",
    "@earendil-works/pi-durable": "1.0.1",
    "@vercel/sandbox": "3.5.1",
    "chat": "4.41.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.9.9"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
