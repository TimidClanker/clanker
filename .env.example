# Subscription login: bun run login openai
# Codex device-code login: bun run login openai-codex
# API-key login: bun run login openrouter api_key
# Login saves credentials here; mount this directory read/write in containers.
SECRETS_DIR=./secrets

# Select provider/model[:reasoning]. Reasoning defaults to low.
# Levels: off, minimal, low, medium, high, xhigh, max (provider support varies).
# MODEL takes precedence over separate MODEL_PROVIDER and MODEL_ID settings.
MODEL=openai-codex/gpt-6-astra:low
QUERY_MODEL=openai-codex/gpt-6-luna:low

# Web search defaults to MODEL; the provider selects OpenAI or OpenRouter hosted search.
# SEARCH_MODEL=openai-codex/gpt-6-luna:high
# SEARCH_MODEL=openrouter/openai/gpt-6-luna:high

# OpenRouter example: MODEL=openrouter/openai/gpt-5.6-sol:low
# Conversation queries default to gpt-6-luna on the same provider when available,
# otherwise MODEL. Override with any provider/model[:reasoning]:
# QUERY_MODEL=openai-codex/gpt-6-luna:low
# Environment API keys also work when no credential is saved for that provider.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Storage: postgres://... or postgresql://... uses Bun SQL; sqlite://... uses SQLite.
# Environment overrides { "url": "..." } in $SECRETS_DIR/database.json (permissions 600).
# Unset/empty configuration defaults to sqlite://./workspace/durable.sqlite.
# PostgreSQL tables are public.clanker_*; one bot process owns its durable storage.
# DATABASE_URL=postgres://user:password@localhost:5432/clanker
# DATABASE_URL=sqlite://./workspace/durable.sqlite
DATABASE_URL=

# Sandbox tools are enabled only when all three credentials are configured at startup.
# Restart after adding credentials. Sandboxes are provisioned on first use.
# Alternatively save { "token": "...", "teamId": "...", "projectId": "..." }
# in $SECRETS_DIR/sandbox.json with permissions 600. Never mount secrets into a sandbox.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# Includes Bun, headed Chromium, Playwright, and a view/control desktop.
# Image changes apply to new workspaces; existing persistent workspaces retain their filesystem.
SANDBOX_IMAGE=vcr.vercel.com/timid-clanker/sandboxes/clanker-sandbox:latest

# Discord Gateway credentials
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
