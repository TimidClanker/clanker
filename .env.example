# Subscription login: bun run login openai
# Codex device-code login: bun run login openai-codex
# API-key login: bun run login openrouter api_key
# Login saves credentials here; mount this directory read/write in containers.
SECRETS_DIR=./secrets

# Select provider/model[:reasoning]. Reasoning defaults to low.
# Levels: off, minimal, low, medium, high, xhigh, max (provider support varies).
# MODEL takes precedence over separate MODEL_PROVIDER and MODEL_ID settings.
MODEL=openai-codex/gpt-6-astra:low
QUERY_MODEL=openai-codex/gpt-6-luna:low

# OpenRouter example: MODEL=openrouter/openai/gpt-5.6-sol:low
# Conversation queries default to gpt-6-luna on the same provider when available,
# otherwise MODEL. Override with any provider/model[:reasoning]:
# QUERY_MODEL=openai-codex/gpt-6-luna:low
# Environment API keys also work when no credential is saved for that provider.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# One bot process per database file. Conversations survive restarts.
DATABASE_PATH=./workspace/durable.sqlite

# Discord Gateway credentials
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
